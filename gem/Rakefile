# frozen_string_literal: true

require "bundler/gem_tasks"
require "minitest/test_task"

Minitest::TestTask.create(:test) do |t|
  t.warning = false
end

# The golden suite (test/golden_test.rb) also runs as part of `rake test`, so
# CI covers it on every Ruby in the matrix. This task exists to run it — and
# only it — while working on component markup.
Minitest::TestTask.create(:golden) do |t|
  t.test_globs = ["test/golden_test.rb"]
  t.warning = false
end

namespace :golden do
  desc "Re-record the golden HTML snapshots from the current components"
  task :update do
    ENV["UPDATE_GOLDEN_SNAPSHOTS"] = "1"
    Rake::Task[:golden].invoke
  end
end

require "standard/rake"

task default: %i[test standard]
